<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AstroSiege" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/void_deep</item>
        <item name="android:statusBarColor">@color/void_deep</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/void_deep</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="colorPrimary">@color/marquee_orange</item>
        <item name="colorAccent">@color/laser_cyan</item>
    </style>

    <!-- Shown for the brief moment between process start and the WebView finishing its
         first paint, so the launch never flashes a plain white screen. -->
    <style name="Theme.AstroSiege.Launch" parent="Theme.AstroSiege">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

</resources>
